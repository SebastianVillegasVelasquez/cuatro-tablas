# Default: /api, which the Vite dev server proxies to the backend (no CORS needed).
# Set an absolute URL only when the API lives on another origin, and then list the
# frontend origin in the backend's TABLAS_CORS_ORIGINS.
# VITE_API_URL=https://api.example.com

# Contact buttons in the last section. Both are optional: a missing or malformed
# value just hides that button. Use digits with country code for WhatsApp.
# VITE_CONTACT_WHATSAPP=573001234567
# VITE_CONTACT_EMAIL=hola@example.com
